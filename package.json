{
	"name": "@reins/cli",
	"version": "1.0.0",
	"description": "Reins —— 运行在终端与桌面的编码智能体：描述任务、审阅执行、合入成果。",
	"private": true,
	"type": "module",
	"main": "desktop/build/main.cjs",
	"bin": {
		"reins": "./src/cli/index.ts"
	},
	"imports": {
		"#src/*": "./src/*",
		"#tests/*": "./tests/*",
		"#web/*": "./web/src/*",
		"#desktop/*": "./desktop/*"
	},
	"engines": {
		"node": ">=22.18"
	},
	"scripts": {
		"typecheck": "tsc --noEmit && tsc -p web --noEmit && tsc -p desktop --noEmit",
		"test": "node --test --test-timeout=30000 \"tests/**/*.test.ts\"",
		"test:dir": "node --test --test-timeout=30000",
		"build:ui": "vite build",
		"build:desktop": "node desktop/build.mjs",
		"build:exe": "npm run build:ui && npm run build:desktop && node desktop/package.mjs",
		"dev:desktop": "npm run build:ui && npm run build:desktop && electron ."
	},
	"devDependencies": {
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "22.20.5",
		"@types/react": "19.2.2",
		"@types/react-dom": "19.2.2",
		"@vitejs/plugin-react": "5.0.4",
		"electron": "38.7.2",
		"electron-builder": "26.0.12",
		"esbuild": "0.27.2",
		"tailwindcss": "4.3.3",
		"typescript": "5.9.3",
		"vite": "7.1.11"
	},
	"dependencies": {
		"@joplin/turndown-plugin-gfm": "1.0.68",
		"domino": "2.1.8",
		"dompurify": "3.4.17",
		"eventsource-parser": "4.1.2",
		"fflate": "0.8.3",
		"get-east-asian-width": "1.7.0",
		"highlight.js": "11.11.2",
		"ignore": "7.0.5",
		"jsonc-parser": "3.3.1",
		"lowlight": "3.3.0",
		"lucide-react": "1.66.0",
		"marked": "18.1.1",
		"react": "19.2.0",
		"react-dom": "19.2.0",
		"turndown": "7.2.4",
		"undici": "7.30.1"
	}
}
