{
	"appId": "com.reins.desktop",
	"productName": "Reins",
	"directories": {
		"output": "desktop/release"
	},
	"files": [
		"desktop/build/**",
		"web/dist/**",
		"package.json"
	],
	"asarUnpack": [
		"desktop/build/**",
		"web/dist/**"
	],
	"electronLanguages": ["zh-CN", "en-US"],
	"win": {
		"target": [
			{ "target": "nsis", "arch": ["x64"] }
		]
	},
	"nsis": {
		"oneClick": false,
		"allowToChangeInstallationDirectory": true,
		"artifactName": "Reins-Setup-${version}.${ext}"
	}
}
