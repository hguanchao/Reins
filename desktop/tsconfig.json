{
	"compilerOptions": {
		"target": "ES2024",
		"lib": ["ES2024", "DOM"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"types": ["node"],

		"strict": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,

		"paths": {
			"#src/*": ["../src/*"]
		}
	},
	"include": ["main.ts"]
}
