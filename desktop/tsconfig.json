{
	"compilerOptions": {
		"target": "ES2024",
		"lib": ["ES2024", "DOM"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"types": ["node"],

		"strict": true,
		"erasableSyntaxOnly": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,

		"paths": {
			"highlight.js": ["../src/types/highlight.js.d.ts"],
			"domino": ["../src/types/domino.d.ts"],
			"#src/*": ["../src/*"],
			"#desktop/*": ["./*"]
		}
	},
	"include": ["*.ts"],
	"exclude": ["server-main.ts"]
}
